{
  "threshold": 0,
  "reporters": ["console", "json"],
  "output": ".jscpd-report",
  "ignore": [
    "**/node_modules/**",
    "**/_site/**",
    "**/.build/**",
    "**/packages/**"
  ],
  "format": ["javascript", "markup", "css", "markdown"],
  "absolute": false,
  "gitignore": true,
  "exitCode": 1,
  "minLines": 3,
  "minTokens": 50,
  "path": [
    "scripts",
    "_lib",
    "_data",
    "css",
    "test",
    "_includes",
    "_layouts",
    "pages",
    "guide-pages"
  ]
}

{
	"name": "chobble-client",
	"version": "1.0.0",
	"type": "module",
	"packageManager": "bun@1.3.11",
	"description": "Chobble Tickets promotional website",
	"scripts": {
		"preinstall": "node -e \"if(!process.env.npm_config_user_agent.startsWith('bun')){console.error('Use bun, not npm/yarn/pnpm');process.exit(1)}\"",
		"serve": "bun scripts/serve.js",
		"build": "bun scripts/build.js",
		"prepare-dev": "bun scripts/prepare-dev.js",
		"sync-files": "bun scripts/sync-files.js",
		"watch": "bun scripts/watch.js",
		"update-pages": "bun scripts/update-pages.js",
		"fetch-google-reviews": "bun scripts/fetch-google-reviews.js",
		"screenshot": "bun scripts/screenshot.js",
		"screenshot:scenarios": "bun scripts/screenshot-scenarios.js",
		"screenshot:text": "bun scripts/add-social-screenshot-text.js",
		"instagram:slideshow": "bun scripts/create-instagram-slideshow.js",
		"instagram:slideshow:capture": "bun scripts/capture-instagram-slideshow.js",
		"video:studio": "bun scripts/video/local.js studio",
		"video:render": "bun scripts/video/render.js",
		"video:render:setup": "bun scripts/video/render.js render SetupJourneyReel videos/setup-journey-reel.mp4",
		"video:stills": "bun scripts/video/render-stills.js",
		"video:render:local": "bun scripts/video/local.js render ChobbleFestReel videos/chobblefest-reel.mp4",
		"evidence:import": "bun scripts/evidence/import.js",
		"evidence:validate": "bun scripts/evidence/validate.js",
		"evidence:review": "bun scripts/evidence/review.js",
		"clean": "rm -rf .build _site",
		"test": "bun scripts/test.js",
		"precommit": "bun scripts/precommit.js",
		"lint": "bunx @biomejs/biome check --config-path=biome.json --error-on-warnings scripts/ _lib/ src.11tydata.js remotion.config.js",
		"lint:fix": "bunx @biomejs/biome check --config-path=biome.json --write scripts/ _lib/ src.11tydata.js remotion.config.js",
		"cpd": "bunx jscpd"
	},
	"imports": {
		"#fp": "@chobble/js-toolkit/fp",
		"#fp/*": "@chobble/js-toolkit/fp/*"
	},
	"devDependencies": {
		"@chobble/js-toolkit": "file:./chobble-template/packages/js-toolkit",
		"@fontsource/noto-sans": "^5.3.0",
		"@remotion/cli": "4.0.505",
		"@remotion/fonts": "4.0.505",
		"@remotion/transitions": "4.0.505",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"remotion": "4.0.505",
		"sharp": "^0.34.5"
	}
}
